{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "ProMail Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Private, real-time email tracking for Gmail with open history, Gmail proxy detection and secure per-install data isolation.",
  "host_permissions": [
    "https://mail.google.com/*",
    "https://promail-tracker-server.onrender.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "ProMail Tracker",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs",
    "identity"
  ],
  "version": "2.4.2",
  "key": "",
  "oauth2": {
    "client_id": "856594320148-mgk87mets58sfpfmpep76bdcnfeb40gr.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
